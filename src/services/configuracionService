import { db } from './firebase'
import {
  collection, doc, addDoc, updateDoc, deleteDoc,
  onSnapshot
} from 'firebase/firestore'

const COL_ENVASES = 'envases'

export function escucharEnvases(callback) {
  // Sin orderBy para evitar índice compuesto — ordenamos en cliente
  return onSnapshot(collection(db, COL_ENVASES), snap => {
    const lista = snap.docs
      .map(d => ({ id: d.id, ...d.data() }))
      .sort((a, b) => a.nombre?.localeCompare(b.nombre))
    callback(lista)
  })
}

export async function crearEnvase(nombre) {
  return addDoc(collection(db, COL_ENVASES), { nombre, creadoEn: new Date().toISOString() })
}

export async function actualizarEnvase(id, nombre) {
  return updateDoc(doc(db, COL_ENVASES, id), { nombre })
}

export async function eliminarEnvase(id) {
  return deleteDoc(doc(db, COL_ENVASES, id))
}
